# Brand name shown in the UI (placeholder — rename freely)
NEXT_PUBLIC_APP_NAME=FlowPad

# Chains offered in the UI: deployment names from contracts/deployments/*.json
# e.g. local | baseSepolia | base | robinhood   (first one is the default)
NEXT_PUBLIC_CHAINS=local

# Ponder indexer API
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:42069

# Public URL of this site (used for metadata links + allowed image host)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional RPC overrides per chain id
# NEXT_PUBLIC_RPC_84532=https://base-sepolia.g.alchemy.com/v2/KEY

# WalletConnect / Reown project id (free at https://cloud.reown.com). Without it only browser wallets work.
# NEXT_PUBLIC_WC_PROJECT_ID=

# Dev only: adds an "Anvil test wallet" that signs with anvil's public test account #0 on the local chain.
NEXT_PUBLIC_DEV_WALLET=1

# Optional locally, REQUIRED in production: store token images + metadata on IPFS via Pinata
# (server-side secret). Without it, uploads are saved to web/.uploads and served by /api/files (dev only).
# PINATA_JWT=
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
