# Production environment for the web app (set these in Vercel → Project → Settings → Environment Variables).
# NEXT_PUBLIC_* values are baked into the JavaScript at BUILD time: after changing one, redeploy.

# Brand name shown in the UI
NEXT_PUBLIC_APP_NAME=FlowPad

# Chains offered in the UI (deployment names from contracts/deployments/*.json). Testnet launch:
NEXT_PUBLIC_CHAINS=baseSepolia

# Public URL of the Ponder indexer on Railway (no trailing slash)
NEXT_PUBLIC_INDEXER_URL=https://your-indexer.up.railway.app

# Public URL of this site (your Vercel domain or custom domain, no trailing slash).
# Used for share previews, referral links and the image allowlist.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# RPC for wallet reads/quotes. Strongly recommended: the public endpoint is rate-limited and can return stale data.
# Alchemy → create app (Base Sepolia) → copy HTTPS URL. This key is visible in the browser, so restrict
# "Allowlisted origins" to your site's domain in the Alchemy dashboard.
NEXT_PUBLIC_RPC_84532=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# WalletConnect / Reown project id (free at https://cloud.reown.com). Needed for mobile wallets.
# Add your site's domain to the project's allowlist.
NEXT_PUBLIC_WC_PROJECT_ID=

# Must be 0 in production (the Anvil test wallet only exists for local development)
NEXT_PUBLIC_DEV_WALLET=0

# IPFS gateway used to show coin images (your Pinata dedicated gateway is fastest)
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# REQUIRED on Vercel: Pinata API JWT (server-side secret, never prefix with NEXT_PUBLIC_).
# Vercel cannot store uploaded files; without this, creating coins with images fails with a clear error.
PINATA_JWT=
