# Deployer for TESTNETS ONLY. Create a fresh wallet with `cast wallet new` and fund it from a faucet.
# Never put a key that holds real money here. For mainnet use a hardware wallet / `--account` keystore.
PRIVATE_KEY=

# Optional: factory owner and fee treasury (default: deployer). Use a Safe multisig on mainnet.
OWNER=
TREASURY=

# Optional: for `forge verify-contract` / `--verify`
ETHERSCAN_API_KEY=
