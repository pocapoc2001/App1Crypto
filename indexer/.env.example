# Comma-separated deployment names to index (see contracts/deployments/*.json): local | baseSepolia | base | robinhood
PONDER_CHAINS=local
# Optional RPC overrides per chain id (recommended in production: Alchemy / QuickNode)
# PONDER_RPC_URL_84532=https://base-sepolia.g.alchemy.com/v2/KEY
# PONDER_RPC_URL_4663=https://robinhood-mainnet.g.alchemy.com/v2/KEY
# Optional: use Postgres instead of the embedded PGlite database
# DATABASE_URL=postgres://user:pass@host:5432/db
