# Production environment for the Ponder indexer (set these in Railway → indexer service → Variables).
# The database schema is set by the start command in indexer/railway.json
# (one schema per deployment = zero-downtime redeploys).

# Port the API listens on. Pinned so the Railway domain's "target port" is unambiguous.
PORT=42069

# Railway Postgres connection string. In the Railway dashboard use "Add Reference" → Postgres → DATABASE_URL,
# which stores this exact reference syntax:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Deployment names to index (see contracts/deployments/*.json)
PONDER_CHAINS=baseSepolia

# RPC per chain id. Strongly recommended (public endpoints are rate-limited and can lag).
# Alchemy → create app (Base Sepolia) → copy HTTPS URL.
PONDER_RPC_URL_84532=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
